{
  "name": "creature-derby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Breed racing creatures. A browser homage to Karl Sims' Evolving Virtual Creatures.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check:ui": "npm run build && node tools/ui-check.mjs",
    "check:camera": "npm run build && node tools/camera-check.mjs",
    "measure": "node tools/locomotion.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
